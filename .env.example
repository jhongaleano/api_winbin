#crea un base de datos en mysql localmente y configura el .env con la url de la base de datos
#verifica el puerto en el que corre tu xampp
DB_URL=jdbc:mysql://host.docker.internal:3306/nombre_bd?createDatabaseIfNotExist=true

#agrega tus crendeciales de usuario y contraseña para la base de datos:
DB_USERNAME=root
DB_PASSWORD=

#secret para generar el token JWT
JWT_SECRET=nQVxEfDkuPNxdpw5n3PJZsccUfFlBXcO7Vk2zsXaA5o=

#tiempo de expiracion del token en milisegundos
JWT_EXPIRATION=3600000